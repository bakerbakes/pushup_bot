# Copy this file to .env and fill in your bot token.
DISCORD_TOKEN=your-bot-token-here

# Optional: where to store the SQLite database file. Defaults to
# pushup_bot.db in the current directory.
DB_PATH=pushup_bot.db

# Optional: GIPHY API key for live/dynamic gifs on daily goal completion.
# If left blank, the bot falls back to the static list in messages.py.
# See README.md for how to get one.
GIPHY_API_KEY=
